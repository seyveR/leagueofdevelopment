    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "fake-indexeddb": "6.0.1",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  }
